{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kevanwee/sg-legal-corpus/schemas/meta.hansard.schema.json",
  "title": "HansardMeta",
  "description": "The meta payload for corpus=hansard records. Level is sitting, section or speech.",
  "type": "object",
  "required": ["level", "parliament_no"],
  "properties": {
    "level": { "enum": ["sitting", "section", "speech"] },
    "parliament_no": { "type": ["integer", "null"] },
    "session_no": { "type": ["integer", "null"] },
    "volume_no": { "type": ["string", "integer", "null"] },
    "sitting_no": { "type": ["string", "integer", "null"] },
    "sitting_type": { "type": ["string", "null"] },

    "section_index": { "type": ["integer", "null"] },
    "section_title": { "type": ["string", "null"] },
    "section_subtitle": { "type": ["string", "null"] },

    "speech_index": { "type": ["integer", "null"] },
    "speaker": {
      "type": ["string", "null"],
      "description": "Null is permitted but counted against the attribution coverage metric. A Hansard quotation without a named speaker is not usable as authority."
    },
    "speaker_role": { "type": ["string", "null"] },
    "constituency": { "type": ["string", "null"] },

    "is_question": { "type": "boolean", "default": false },
    "question_no": { "type": ["string", "null"] },
    "bill_ref": { "type": ["string", "null"] },

    "attendance_count": { "type": ["integer", "null"] },
    "section_count": { "type": ["integer", "null"] }
  }
}
